{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Firefox: Vite dev",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "reAttach": true,
      "pathMappings": [{ "url": "http://localhost:5173/src", "path": "${workspaceFolder}/src" }]
    }
  ]
}
